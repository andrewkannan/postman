generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Setting {
  id        Int      @id @default(1)
  host      String   @default("")
  port      Int      @default(587)
  user      String   @default("")
  pass      String   @default("")
  interval     Int      @default(5)
  subject      String   @default("")
  htmlTemplate String   @default("<h1>Hello {name}</h1><p>This is a test email.</p>")
  updatedAt    DateTime @updatedAt
}

model EmailLog {
  id        Int      @id @default(autoincrement())
  email     String
  status    String
  message   String?
  timestamp DateTime @default(now())
}
